@routineTemplateId = 1

###
POST {{baseUrl}}/routine-template
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Push Pull Legs",
  "days": [
    {
      "exercises": [
        {
          "exerciseId": 1
        },
        {
          "exerciseId": 2
        }
      ]
    },
    {
      "dayOrder": 2,
      "exercises": [
        {
          "exerciseId": 3
        }
      ]
    }
  ]
}

###
GET {{baseUrl}}/routine-template
Authorization: Bearer {{accessToken}}

###
GET {{baseUrl}}/routine-template/{{routineTemplateId}}
Authorization: Bearer {{accessToken}}

###
PUT {{baseUrl}}/routine-template/{{routineTemplateId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Updated Routine",
  "days": [
    {
      "exercises": [
        {
          "exerciseId": 1
        }
      ]
    },
    {
      "exercises": [
        {
          "exerciseId": 2
        },
        {
          "exerciseId": 4
        }
      ]
    }
  ]
}

###
DELETE {{baseUrl}}/routine-template/{{routineTemplateId}}
Authorization: Bearer {{accessToken}}