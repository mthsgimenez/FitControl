@routineId = 4
@memberId = 3

###
POST {{baseUrl}}/routine
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Push Pull Legs",
  "memberId": 1,
  "days": [
    {
      "dayOrder": 1,
      "exercises": [
        {
          "exerciseId": 1,
          "exerciseOrder": 1,
          "reps": 12,
          "series": 3
        },
        {
          "exerciseId": 2,
          "exerciseOrder": 2,
          "reps": 8,
          "series": 4
        }
      ]
    },
    {
      "dayOrder": 2,
      "exercises": [
        {
          "exerciseId": 3,
          "exerciseOrder": 1,
          "reps": 8,
          "series": 4
        }
      ]
    }
  ]
}

###
GET {{baseUrl}}/routine/{{routineId}}
Authorization: Bearer {{accessToken}}

###
GET {{baseUrl}}/routine/member/{{memberId}}
Authorization: Bearer {{accessToken}}

###
PUT {{baseUrl}}/routine/{{routineId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Updated routine",
  "days": [
    {
      "dayOrder": 1,
      "exercises": [
        {
          "exerciseId": 1,
          "exerciseOrder": 1,
          "reps": 12,
          "series": 3
        },
        {
          "exerciseId": 2,
          "exerciseOrder": 2,
          "reps": 8,
          "series": 4
        }
      ]
    },
    {
      "dayOrder": 2,
      "exercises": [
        {
          "exerciseId": 3,
          "exerciseOrder": 1,
          "reps": 8,
          "series": 4,
          "notes": "Última série até a falha"
        }
      ]
    }
  ]
}

###
DELETE {{baseUrl}}/routine/{{routineId}}
Authorization: Bearer {{accessToken}}